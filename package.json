{
  "name": "vue-smart-state",
  "version": "0.2.0",
  "description": "A type-safe, reactive, persistent and cross-tab synced useState composable for Vue 3 — with TTL, versioned migrations, schema validation, custom storage (cookies included) and SSR safety.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "state",
    "state-management",
    "useState",
    "react-usestate",
    "composable",
    "composition-api",
    "persistent",
    "persisted-state",
    "localStorage",
    "sessionStorage",
    "storage",
    "cross-tab",
    "broadcast",
    "cookie",
    "standard-schema",
    "zod",
    "validation",
    "migration",
    "ttl",
    "expiry",
    "debounce",
    "ssr",
    "typescript"
  ],
  "author": "Luigi Davide Micca <luigimicca94@gmail.com> (https://luigimicca.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuigiDavideMicca/vue-smart-state.git"
  },
  "homepage": "https://github.com/LuigiDavideMicca/vue-smart-state#readme",
  "bugs": {
    "url": "https://github.com/LuigiDavideMicca/vue-smart-state/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vue": ">=3.2.0"
  },
  "devDependencies": {
    "happy-dom": "^20.0.11",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.40"
  }
}
